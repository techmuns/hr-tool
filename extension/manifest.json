{
  "manifest_version": 3,
  "name": "HR Tool Attendance",
  "description": "Clock in and out of the HR tool with a keyboard shortcut — no need to open the site.",
  "version": "1.0.0",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HR Tool Attendance",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "clock-in": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Clock in"
    },
    "clock-out": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Clock out"
    }
  }
}
