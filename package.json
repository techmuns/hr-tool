{
  "name": "hr-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:create": "wrangler d1 create hr-tool-db",
    "db:migrate:local": "wrangler d1 migrations apply hr-tool-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hr-tool-db --remote",
    "db:seed:local": "wrangler d1 execute hr-tool-db --local --file=./migrations/0002_seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^3.99.0"
  }
}
