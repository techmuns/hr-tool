# Munshot origin(s) allowed to postMessage into this app when it's embedded as
# an iframe (see src/web/lib/sdk.ts, src/web/hooks/useHostContext.ts).
# Comma-separated, exact scheme+host, no trailing slash. Left unset, every
# postMessage-sourced host session is rejected — the app falls back to its own
# OTP login instead of silently trusting an unconfigured allow-list.
VITE_MUNSHOT_ALLOWED_ORIGINS=https://app.munshot.com
