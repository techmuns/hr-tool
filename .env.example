# Munshot origin(s) allowed to postMessage into this app when it's embedded as
# an iframe (see src/web/lib/sdk.ts, src/web/hooks/useHostContext.ts).
# Comma-separated, exact scheme+host, no trailing slash — no wildcards; the
# vendor SDK matches with a plain Set.has(origin), so every muns.io subdomain
# that's actually allowed to embed this app must be listed explicitly. Left
# unset, this falls back to the hardcoded DEFAULT_ALLOWED_HOST_ORIGINS in
# sdk.ts (currently just https://chat.muns.io) rather than an empty list.
VITE_MUNSHOT_ALLOWED_ORIGINS=https://chat.muns.io
