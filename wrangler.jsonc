{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hr-tool",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build && sh scripts/ci-migrate.sh"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hr-tool-db",
      "database_id": "4926875e-43fb-485d-81e6-65cb2b3c00f9",
      "migrations_dir": "migrations"
    }
  ],
  // Reimbursement bill attachments — paused for now (needs an R2 bucket, which
  // isn't set up on this account yet). D1 caps a row at 2 MB, under the 3 MB
  // bills are meant to allow, so the files were going to R2 with D1 keeping
  // only the object key. The client-side upload UI is commented out to match
  // (see ReimbursementRequest.tsx / EmployeePanel.tsx), so nothing calls this
  // binding right now. To resume: `npx wrangler r2 bucket create hr-tool-bills`,
  // uncomment this block, and uncomment the BillPicker/BillLink usages.
  // "r2_buckets": [
  //   {
  //     "binding": "BILLS",
  //     "bucket_name": "hr-tool-bills"
  //   }
  // ],
  "observability": {
    "enabled": true
  }
}
